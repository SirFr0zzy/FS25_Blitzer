<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="114">
    <author>Elias</author>
    <version>0.1.0.0</version>
    <title>
        <en>Blitzer Mod</en>
        <de>Blitzer Mod</de>
    </title>
    <description>
        <en><![CDATA[Handheld low poly speed radar gun plus a stationary speed camera column (build menu > Decoration > Others, 90 degree flash range, speed limit adjustable at the column). Buy it in the shop (Hand tools), equip it, aim at a vehicle and hold the trigger to read its speed.]]></en>
        <de><![CDATA[Handliche Low-Poly-Radarpistole. Im Shop (Handwerkzeuge) kaufen, ausrüsten, auf ein Fahrzeug zielen und Auslöser halten, um dessen Geschwindigkeit zu messen.]]></de>
    </description>
    <iconFilename>store_icon.dds</iconFilename>
    <multiplayer supported="true"/>

    <extraSourceFiles>
        <sourceFile filename="scripts/SpeedGunRegister.lua"/>
        <sourceFile filename="scripts/BlitzerManager.lua"/>
    </extraSourceFiles>

    <placeableSpecializations>
        <specialization name="blitzer" className="PlaceableBlitzer" filename="scripts/PlaceableBlitzer.lua"/>
    </placeableSpecializations>

    <placeableTypes>
        <type name="blitzer" parent="simplePlaceable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="blitzer"/>
        </type>
    </placeableTypes>

    <storeItems>
        <storeItem xmlFilename="objects/speedGun/speedGun.xml"/>
        <storeItem xmlFilename="objects/blitzer/blitzer.xml"/>
    </storeItems>

    <l10n filenamePrefix="translations/l10n"/>
</modDesc>
